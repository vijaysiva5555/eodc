MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGODB_DB=eodc
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: customs station name shown on the login page, e.g. "Custom House, Surat"
NEXT_PUBLIC_CUSTOMS_STATION=

# File uploads are stored in S3 under AWS_S3_PREFIX/. Leave AWS_S3_BUCKET empty to keep files in ./storage (local dev only).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=import
